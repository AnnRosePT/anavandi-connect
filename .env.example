# AnaVandi Connect Environment Configuration

# Optional Vision AI Provider (Gemini / Google AI Studio API Key)
# If provided, real AI timetable vision extraction will be performed.
# If omitted or empty, deterministic high-fidelity demo extraction mode will be used automatically.
AI_API_KEY=
NEXT_PUBLIC_AI_API_KEY=

# Optional Supabase Configuration (if remote sync is enabled)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
